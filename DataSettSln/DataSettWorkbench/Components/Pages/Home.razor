@page "/"
@using DataSett.Metamodel
@using DataSett.ViewModel

@inject WorkbenchMainViewmodel ViewModel

<PageTitle>DataSett Workbench</PageTitle>

<MudText Typo="Typo.h1" Align="Align.Center" GutterBottom="true">Logical Business Object Mapping</MudText>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <!-- TextField nimmt die gesamte Breite ein und ist oben -->
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudTextField @bind-Value="ViewModel.ServerPath" 
                              Label="Server Path" 
                              Variant="Variant.Outlined" 
                              Adornment="Adornment.End" 
                              AdornmentIcon="@Icons.Material.Filled.Folder"
                              AdornmentColor="Color.Primary"
                              HelperText="Choose your repository path"
                              Immediate="false"/>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="LoadDataFromPath"
                           Class="mt-2">
                    Refresh
                </MudButton>
            </MudPaper>
        </MudItem>
        
        <!-- TreeView nimmt 25% der Breite (2 von 12 Spalten) -->
        <MudItem xs="12" sm="2">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto;">
                <MudTreeView
                    T="SourceSystem"
                    Items="@TreeItems"
                    SelectionMode="SelectionMode.SingleSelection"
                    @bind-SelectedValue="ViewModel.SelectedSourceSystem">

                    <ItemTemplate>
                        <MudTreeViewItem Value="@context.Value" Text="@context.Text" Icon="@context.Icon" />
                    </ItemTemplate>
                </MudTreeView>
            </MudPaper>
        </MudItem>
        
        <!-- DataGrid nimmt 75% der Breite (9 von 12 Spalten) -->
        <MudItem xs="12" sm="10">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                @if (ViewModel.SelectedSourceSystem?.SourceInterfaces != null)
                {
                    <MudDataGrid Items="@ViewModel.SelectedSourceSystem.SourceInterfaces">
                        <Columns>
                            <PropertyColumn Property="x => x.Name" />
                            <PropertyColumn Property="x => x.Schema" />
                        </Columns>
                    </MudDataGrid>
                }
                else
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                        Bitte wählen Sie ein Quellsystem aus.
                    </MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {

    public List<TreeItemData<SourceSystem>> TreeItems { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataFromPath();
    }

    private async Task LoadDataFromPath()
    {
        await ViewModel.LoadDataFromPathAsync(ViewModel.ServerPath);
        TreeItems = ViewModel.SourceSystems
            .Select(ss => new TreeItemData<SourceSystem>
            {
                Text = ss.Name,
                Value = ss,
                Icon = Icons.Material.Filled.Storage
            })
            .ToList();
        StateHasChanged();
    }

}