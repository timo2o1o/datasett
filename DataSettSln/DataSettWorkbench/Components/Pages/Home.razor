@page "/"
@using DataSett.Metamodel
@using DataSett.ViewModel

@inject WorkbenchMainViewmodel ViewModel

<PageTitle>DataSett Workbench</PageTitle>

<MudText Typo="Typo.h1" Align="Align.Center" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.DatasetLinked" Class="mr-2" Size="Size.Large" Style="font-size: 4rem;" />
    Logical Business Concept Mapping
</MudText>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <!-- TextField nimmt die gesamte Breite ein und ist oben -->
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudTextField @bind-Value="ViewModel.ServerPath" 
                              Label="Server Path" 
                              Variant="Variant.Outlined" 
                              Adornment="Adornment.End" 
                              AdornmentIcon="@Icons.Material.Filled.Folder"
                              AdornmentColor="Color.Primary"
                              HelperText="Choose your repository path"
                              Immediate="false"/>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="LoadDataFromPath"
                           Class="mt-2">
                    Refresh
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="@(() => ViewModel.SaveChangesAsync())"
                           Class="mt-2">
                    Save Changes
                </MudButton>
            </MudPaper>
        </MudItem>
        
        <!-- TreeView nimmt 25% der Breite (2 von 12 Spalten) -->
        <MudItem xs="12" sm="2">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto;">
                <MudTreeView
                    T="object"
                    Items="@TreeItems"
                    SelectionMode="SelectionMode.SingleSelection"
                    SelectedValueChanged="OnTreeItemSelected">

                    <ItemTemplate>
                        <MudTreeViewItem Value="@context.Value"
                                         Text="@context.Text"
                                         Icon="@context.Icon"
                                         Items="@context.Children" />
                    </ItemTemplate>
                </MudTreeView>
            </MudPaper>
        </MudItem>
        
        <!-- DataGrid nimmt 75% der Breite (9 von 12 Spalten) -->
        <MudItem xs="12" sm="10">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                @if (ViewModel.SelectedSourceInterface != null)
                {
                    <MudDataGrid
                        Items="@ViewModel.FilteredBusinessConceptMappings"
                        ReadOnly=false
                        EditMode="DataGridEditMode.Cell">
                        <Columns>
                            <PropertyColumn Property="x => x.SourceAttribute != null ? x.SourceAttribute.Name : string.Empty" />
                            <PropertyColumn Property="x => x.HarmonizedName" />
                            <PropertyColumn Property="x => x.OrderNo" />
                            <PropertyColumn Property="x => x.ParentBusinessConcept != null ? x.ParentBusinessConcept.Name : string.Empty" Title="BusinessConcept">
                                <EditTemplate>
                                    <MudSelect @bind-Value="context.Item.ParentBusinessConcept" Required RequiredError="Please select a business concept." Margin="@Margin.Dense">
                                        @foreach (var bc in ViewModel.BusinessConcepts)
                                        {
                                            <MudSelectItem Value="@(bc)">@bc.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </EditTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.Role">
                                <EditTemplate>
                                    <MudSelect @bind-Value="context.Item.Role" Required RequiredError="Please select a role." Margin="@Margin.Dense">
                                        @foreach (var role in Enum.GetValues<SourceAttributeRole>())
                                        {
                                            <MudSelectItem Value="@(role)">@role</MudSelectItem>
                                        }
                                    </MudSelect>
                                </EditTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.HistoryType">
                                <EditTemplate>
                                    <MudSelect @bind-Value="context.Item.HistoryType" Required RequiredError="Please select an history type." Margin="@Margin.Dense">
                                        @foreach (var type in Enum.GetValues<HistoryType>())
                                        {
                                            <MudSelectItem Value="@(type)">@type</MudSelectItem>
                                        }
                                    </MudSelect>
                                </EditTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.AttributeSetName" Editable="false" />
                            <PropertyColumn Property="x => x.MappingProperties.Datatype" />
                            <PropertyColumn Property="x => x.MappingProperties.Default" />
                            <PropertyColumn Property="x => x.MappingProperties.Length" />
                            <PropertyColumn Property="x => x.MappingProperties.IsNullable" />
                            <PropertyColumn Property="x => x.MappingProperties.Position" />
                            <PropertyColumn Property="x => x.MappingProperties.Precision" />
                        </Columns>
                    </MudDataGrid>
                }
                else
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                        Please choose a source interface to display its attribute mapping.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

    </MudGrid>
</MudContainer>

@code {

    public HashSet<TreeItemData<object>> TreeItems { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (ViewModel.SourceSystems.Count == 0)
        {
            await LoadDataFromPath();
        }
    }

    private async Task LoadDataFromPath()
    {
        await ViewModel.LoadDataFromPathAsync(ViewModel.ServerPath);
        TreeItems = ViewModel.SourceSystems
            .Select(ss => new TreeItemData<object>
            {
                Text = ss.Name,
                Value = ss,
                Icon = Icons.Material.Filled.Storage,
                Children = ss.SourceInterfaces?
                    .Select(si => new TreeItemData<object>
                    {
                        Text = si.Name,
                        Value = si,
                        Icon = Icons.Material.Filled.TableRows
                    })
                    .ToList()
            })
            .ToHashSet();
        StateHasChanged();
    }

    private void OnTreeItemSelected(object selectedValue)
    {
        // If a SourceSystem got selected, set it in the ViewModel
        if (selectedValue is SourceSystem sourceSystem)
        {
            ViewModel.SelectedSourceSystem = sourceSystem;
            ViewModel.SelectedSourceInterface = null;
        }
        // If a SourceInterface got selected, set it's parent SourceSystem
        else if (selectedValue is SourceInterface sourceInterface)
        {
            ViewModel.SelectedSourceSystem = sourceInterface.ParentSourceSystem;
            ViewModel.SelectedSourceInterface = sourceInterface;
        }
    }

}