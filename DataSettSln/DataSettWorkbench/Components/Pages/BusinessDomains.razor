@page "/businessdomains"
@using DataSett.Metamodel
@using DataSett.ViewModel

@using Blazor.Diagrams
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using Blazor.Diagrams.Components
@using DataSettWorkbench.Components.DiagramNodes

@inject BusinessDomainViewModel ViewModel
@inject MainLayoutViewModel MainLayoutViewModel

@implements IDisposable

<PageTitle>Business Domain Management</PageTitle>

<MudText Typo="Typo.h1" Align="Align.Center" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.Domain" Class="mr-2" Size="MudBlazor.Size.Large" Style="font-size: 4rem;" />
    Business Domain Management
</MudText>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        
        <!-- DataGrid showing business domains -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto;">
                <MudText Typo="Typo.h6" GutterBottom="true">Business Domains</MudText>
                @if (ViewModel.BusinessDomains != null && ViewModel.BusinessDomains.Any())
                {
                    <MudDataGrid T="BusinessDomain" 
                                 Items="@ViewModel.BusinessDomains"
                                 SelectedItemChanged="@OnBusinessDomainSelected"
                                 Hover="true"
                                 Dense="true">
                        <Columns>
                            <PropertyColumn Property="x => x.Name" Title="Domain Name" />
                            <PropertyColumn Property="x => x.ParentBusinessDomain != null ? x.ParentBusinessDomain.Name : string.Empty" 
                                          Title="Parent Domain" />
                            <PropertyColumn Property="x => x.ChildBusinessDomains.Count" Title="Child Domains" />
                            <PropertyColumn Property="x => x.BusinessConcepts.Count" Title="Business Concepts" />
                        </Columns>
                    </MudDataGrid>
                }
                else
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                        No business domains found. Please load data from a repository path.
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        
        <!-- Hierarchy Visualization -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                <MudText Typo="Typo.h6" GutterBottom="true">Domain Hierarchy</MudText>
                <div class="diagram-container">
                    <CascadingValue Value="Diagram" IsFixed="true">
                        <DiagramCanvas></DiagramCanvas>
                    </CascadingValue>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private BlazorDiagram Diagram { get; set; } = null!;

    protected override void OnInitialized()
    {
        MainLayoutViewModel.DataReloaded += OnDataReloaded;
        ViewModel.GetBusinessDomainData();
        BuildDiagram();
    }

    private BlazorDiagram CreateDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            Zoom = { Enabled = true },
            Links =
            {
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new StraightPathGenerator()
            },
        };
        var diagram = new BlazorDiagram(options);
        diagram.RegisterComponent<DomainNodeModel, DomainNode>();
        return diagram;
    }

    private void BuildDiagram()
    {
        Diagram = CreateDiagram();

        if (ViewModel.BusinessDomains == null || !ViewModel.BusinessDomains.Any())
            return;

        var nodeMap = new Dictionary<string, DomainNodeModel>();

        foreach (var domain in ViewModel.BusinessDomains)
        {
            var node = Diagram.Nodes.Add(new DomainNodeModel(domain));
            if (domain.Name is not null)
                nodeMap[domain.Name] = node;
        }

        foreach (var domain in ViewModel.BusinessDomains)
        {
            if (domain.ParentBusinessDomain?.Name is string parentName &&
                nodeMap.TryGetValue(parentName, out var parentNode) &&
                domain.Name is not null &&
                nodeMap.TryGetValue(domain.Name, out var childNode))
            {
                var sourceAnchor = new ShapeIntersectionAnchor(parentNode);
                var targetAnchor = new ShapeIntersectionAnchor(childNode);
                Diagram.Links.Add(new LinkModel(sourceAnchor, targetAnchor));
            }
        }

        ApplyTreeLayout(nodeMap);
    }

    private void ApplyTreeLayout(Dictionary<string, DomainNodeModel> nodeMap)
    {
        const double nodeWidth = 140;
        const double nodeHeight = 56;
        const double horizontalGap = 30;
        const double verticalGap = 60;

        // Assign levels via BFS from root nodes
        var levels = new Dictionary<string, int>();
        var queue = new Queue<(string name, int level)>();

        foreach (var domain in ViewModel.BusinessDomains.Where(d => d.ParentBusinessDomain == null))
        {
            if (domain.Name is not null)
            {
                levels[domain.Name] = 0;
                queue.Enqueue((domain.Name, 0));
            }
        }

        // Build children lookup for efficient BFS
        var childrenLookup = ViewModel.BusinessDomains
            .Where(d => d.ParentBusinessDomain?.Name is not null && d.Name is not null)
            .GroupBy(d => d.ParentBusinessDomain!.Name!)
            .ToDictionary(g => g.Key, g => g.Select(d => d.Name!).ToList());

        while (queue.Count > 0)
        {
            var (name, level) = queue.Dequeue();
            if (!childrenLookup.TryGetValue(name, out var children))
                continue;
            foreach (var childName in children)
            {
                if (!levels.ContainsKey(childName))
                {
                    levels[childName] = level + 1;
                    queue.Enqueue((childName, level + 1));
                }
            }
        }

        // Group by level and position nodes
        var nodesByLevel = levels
            .GroupBy(kv => kv.Value)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.Select(kv => kv.Key).ToList());

        const double startX = 20;
        const double startY = 20;

        foreach (var (level, names) in nodesByLevel.OrderBy(kv => kv.Key))
        {
            double y = startY + level * (nodeHeight + verticalGap);
            for (int i = 0; i < names.Count; i++)
            {
                if (nodeMap.TryGetValue(names[i], out var node))
                {
                    node.Position = new Point(startX + i * (nodeWidth + horizontalGap), y);
                    node.Size = new Blazor.Diagrams.Core.Geometry.Size(nodeWidth, nodeHeight);
                }
            }
        }
    }

    private void OnBusinessDomainSelected(BusinessDomain? selectedDomain)
    {
        ViewModel.SelectedBusinessDomain = selectedDomain;
        StateHasChanged();
    }

    private async void OnDataReloaded()
    {
        await InvokeAsync(() =>
        {
            ViewModel.GetBusinessDomainData();
            BuildDiagram();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        MainLayoutViewModel.DataReloaded -= OnDataReloaded;
    }
}
