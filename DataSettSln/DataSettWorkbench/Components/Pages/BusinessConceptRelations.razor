@page "/businessconceptrelations"

@using DataSett.Metamodel
@using DataSett.ViewModel
@using DataSett.ViewModel.DisplayItems

@using Blazor.Diagrams;
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.PathGenerators;
@using Blazor.Diagrams.Core.Routers;
@using Blazor.Diagrams.Options;

@using Blazor.Diagrams.Components
@using DataSettWorkbench.Components.DiagramNodes

@inject BusinessConceptRelationViewModel ViewModel
@inject WorkbenchMainViewmodel MainViewModel

<PageTitle>Business Concept Relations</PageTitle>

<MudText Typo="Typo.h1" Align="Align.Center" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" Size="MudBlazor.Size.Large" Style="font-size: 4rem;" />
    Business Concept Relations
</MudText>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <MudItem xs="12">
            <MudToolBar Dense="true" Class="mb-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!CanPersistSelection)"
                           OnClick="PersistSelectedRelation"
                           StartIcon="@Icons.Material.Filled.Save">
                    Persist Relation
                </MudButton>
                <MudText Typo="Typo.caption" Class="ml-4">
                    Select a derived (dashed) relation and click Persist or press Space to persist it.
                </MudText>
            </MudToolBar>
        </MudItem>
        <MudItem xs="12">
            <MudPaper>
                <div class="diagram-container" tabindex="0" @onkeydown="OnKeyDown">
                    <CascadingValue Value="Diagram" IsFixed="true">
                        <DiagramCanvas></DiagramCanvas>
                    </CascadingValue>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@implements IDisposable

@code {

    private BlazorDiagram Diagram { get; set; } = null!;

    private bool CanPersistSelection => ViewModel.CanPersistSelection;

    private BlazorDiagram InitializeDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            Zoom =
            {
                Enabled = false,
            },
            Links =
            {
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new SmoothPathGenerator()
            },
        };
        var diagram = new BlazorDiagram(options);
        diagram.RegisterComponent<DiamondNodeModel, DiamondNode>();
        diagram.RegisterComponent<RelationLinkModel, RelationLink>();
        return diagram;
    }

    protected override void OnInitialized()
    {
        MainViewModel.DataReloaded += OnDataReloaded;

        ViewModel.GetBusinessConceptData();

        Diagram = InitializeDiagram();

        // When a link is removed from the diagram, also remove the
        // corresponding BusinessConceptRelationItem from its display item.
        Diagram.Links.Removed += OnLinkRemoved;

        // Track selection changes so the Persist button state updates
        Diagram.SelectionChanged += OnSelectionChanged;

        // Build a lookup from BusinessConcept name to its diagram node
        var bcNodeMap = new Dictionary<string, NodeModel>();

        foreach (BusinessConcept currentBC in ViewModel.BusinessConcepts)
        {
            var node = Diagram.Nodes.Add(new NodeModel()
            {
                Title = currentBC.Name
            });
            node.AddPort(PortAlignment.Right);

            if (currentBC.Name is not null)
            {
                bcNodeMap[currentBC.Name] = node;
            }
        }

        ViewModel.GetBusinessConceptRelationData();

        foreach (BusinessConceptRelationDisplayitem businessConceptRelationDisplayItem in ViewModel.BusinessConceptRelations)
        {
            // Add a diamond-shaped node for each relation
            var diamondNode = Diagram.Nodes.Add(new DiamondNodeModel()
            {
                RelationName = businessConceptRelationDisplayItem.RelationName,
                IsPersisted = businessConceptRelationDisplayItem.IsPersisted,
                DisplayItem = businessConceptRelationDisplayItem
            });

            // Link the diamond to each related BusinessConcept node
            foreach (BusinessConceptRelationItem relationItem in businessConceptRelationDisplayItem.BusinessConceptRelationItems)
            {
                var bcName = relationItem.RelatedBusinessConcept?.Name;
                if (bcName is null || !bcNodeMap.TryGetValue(bcName, out var targetNode))
                    continue;

                var sourceAnchor = new ShapeIntersectionAnchor(diamondNode);
                var targetAnchor = new ShapeIntersectionAnchor(targetNode);
                Diagram.Links.Add(new RelationLinkModel(
                    sourceAnchor, targetAnchor,
                    businessConceptRelationDisplayItem.IsPersisted,
                    businessConceptRelationDisplayItem,
                    relationItem));
            }
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Code == "Space")
        {
            PersistSelectedRelation();
        }
    }

    private void PersistSelectedRelation()
    {
        // Delegate domain mutation to the ViewModel
        var persisted = ViewModel.PersistSelectedRelations();

        // Update diagram visuals for each newly persisted relation
        foreach (var displayItem in persisted)
        {
            var diamondNode = Diagram.Nodes
                .OfType<DiamondNodeModel>()
                .FirstOrDefault(n => n.DisplayItem == displayItem);

            if (diamondNode is null) continue;

            diamondNode.IsPersisted = true;
            diamondNode.Refresh();

            foreach (var link in diamondNode.Links.OfType<RelationLinkModel>())
            {
                link.IsPersisted = true;
                link.Refresh();
            }
        }

        StateHasChanged();
    }

    private void OnSelectionChanged(SelectableModel model)
    {
        // Sync the diagram selection into the ViewModel
        var selectedDisplayItems = Diagram.GetSelectedModels()
            .OfType<DiamondNodeModel>()
            .Where(n => n.DisplayItem is not null)
            .Select(n => n.DisplayItem!);

        ViewModel.UpdateSelection(selectedDisplayItems);
        InvokeAsync(StateHasChanged);
    }

    private void OnDataReloaded()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLinkRemoved(BaseLinkModel link)
    {
        if (link is RelationLinkModel relationLink)
        {
            ViewModel.RemoveRelationItem(relationLink.ParentDisplayItem, relationLink.RelationItem);
        }
    }

    public void Dispose()
    {
        MainViewModel.DataReloaded -= OnDataReloaded;
        Diagram.Links.Removed -= OnLinkRemoved;
        Diagram.SelectionChanged -= OnSelectionChanged;
    }

}