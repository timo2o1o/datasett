@page "/businessconceptrelations"

@using DataSett.Metamodel
@using DataSett.ViewModel
@using DataSett.ViewModel.DisplayItems

@using Blazor.Diagrams;
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators;
@using Blazor.Diagrams.Core.Routers;
@using Blazor.Diagrams.Options;

@using Blazor.Diagrams.Components
@using DataSettWorkbench.Components.DiagramNodes

@inject BusinessConceptRelationViewModel ViewModel

<PageTitle>Business Concept Relations</PageTitle>

<MudText Typo="Typo.h1" Align="Align.Center" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" Size="MudBlazor.Size.Large" Style="font-size: 4rem;" />
    Business Concept Relations
</MudText>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <MudItem xs="12">
            <MudPaper>
                <div class="diagram-container">
                    <CascadingValue Value="Diagram" IsFixed="true">
                        <DiagramCanvas></DiagramCanvas>
                    </CascadingValue>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {

    private BlazorDiagram Diagram { get; set; } = null!;

    private BlazorDiagram InitializeDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            Zoom =
            {
                Enabled = false,
            },
            Links =
            {
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new SmoothPathGenerator()
            },
        };
        var diagram = new BlazorDiagram(options);
        diagram.RegisterComponent<DiamondNodeModel, DiamondNode>();
        return diagram;
    }

    protected override void OnInitialized()
    {

        ViewModel.GetBusinessConceptData();

        Diagram = InitializeDiagram();

        // Build a lookup from BusinessConcept name to its diagram node
        var bcNodeMap = new Dictionary<string, NodeModel>();

        foreach (BusinessConcept currentBC in ViewModel.BusinessConcepts)
        {
            var node = Diagram.Nodes.Add(new NodeModel()
            {
                Title = currentBC.Name
            });
            node.AddPort(PortAlignment.Right);

            if (currentBC.Name is not null)
            {
                bcNodeMap[currentBC.Name] = node;
            }
        }

        ViewModel.GetBusinessConceptRelationData();

        foreach (BusinessConceptRelationDisplayitem businessConceptRelationDisplayItem in ViewModel.BusinessConceptRelations)
        {
            // Add a diamond-shaped node for each relation
            var diamondNode = Diagram.Nodes.Add(new DiamondNodeModel()
            {
                Names = businessConceptRelationDisplayItem.Names
            });

            // Link the diamond to each related BusinessConcept node
            foreach (BusinessConceptRelationItem relationItem in businessConceptRelationDisplayItem.BusinessConceptRelationItems)
            {
                var bcName = relationItem.RelatedBusinessConcept?.Name;
                if (bcName is null || !bcNodeMap.TryGetValue(bcName, out var targetNode))
                    continue;

                var sourceAnchor = new ShapeIntersectionAnchor(diamondNode);
                var targetAnchor = new ShapeIntersectionAnchor(targetNode);
                Diagram.Links.Add(new LinkModel(sourceAnchor, targetAnchor));
            }
        }
    }

}