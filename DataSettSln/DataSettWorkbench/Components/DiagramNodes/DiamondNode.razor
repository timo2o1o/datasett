@using Blazor.Diagrams.Core.Models
@using DataSettWorkbench.Components.DiagramNodes

<div class="diamond-node @(Node.IsPersisted ? "" : "diamond-node--unpersisted")">
    <input class="diamond-label"
           value="@Node.RelationName"
           @onchange="OnRelationNameChanged"
           @onpointerdown:stopPropagation="true"
           @onkeydown:stopPropagation="true" />
</div>

@code {
    [Parameter]
    public DiamondNodeModel Node { get; set; } = null!;

    private void OnRelationNameChanged(ChangeEventArgs e)
    {
        Node.RelationName = e.Value?.ToString() ?? string.Empty;
        Node.Refresh();
    }
}
