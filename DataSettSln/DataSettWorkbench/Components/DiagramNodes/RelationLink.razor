@using Blazor.Diagrams
@using Blazor.Diagrams.Extensions
@using DataSettWorkbench.Components.DiagramNodes

<g class="diagram-link" style="display: @(Link.Visible ? "unset" : "none")">
    @if (Link.PathGeneratorResult != null)
    {
        @for (var i = 0; i < Link.PathGeneratorResult.Paths.Length; i++)
        {
            var idx = i;
            var d = Link.PathGeneratorResult.Paths[idx].ToString();
            var strokeStyle = $"stroke: {(Link.Selected ? Link.SelectedColor : Link.Color)}; stroke-width: {Link.Width}px;{(Link.IsPersisted ? "" : " stroke-dasharray: 8 4;")}";
            <path d="@d" style="@strokeStyle" />
            <path d="@d"
                  class="invisible"
                  style="stroke-width: @(Link.Width + 10)px"
                  @onpointerdown="OnPointerDown"
                  @onpointerup="OnPointerUp" />
        }
    }
</g>

@code {
    [CascadingParameter]
    public BlazorDiagram BlazorDiagram { get; set; } = null!;

    [Parameter]
    public RelationLinkModel Link { get; set; } = null!;

    private void OnPointerDown(Microsoft.AspNetCore.Components.Web.PointerEventArgs e) =>
        BlazorDiagram.TriggerPointerDown(Link, e.ToCore());

    private void OnPointerUp(Microsoft.AspNetCore.Components.Web.PointerEventArgs e) =>
        BlazorDiagram.TriggerPointerUp(Link, e.ToCore());
}
