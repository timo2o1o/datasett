@using DataSettWorkbench.Components.DiagramNodes

@if (Link.PathGeneratorResult != null)
{
    @for (var i = 0; i < Link.PathGeneratorResult.Paths.Length; i++)
    {
        var d = Link.PathGeneratorResult.Paths[i].ToString();
        var stroke = Link.Selected ? Link.SelectedColor : Link.Color;
        var dashArray = Link.IsPersisted ? null : "8 4";
        <path d="@d"
              fill="none"
              stroke="@stroke"
              stroke-width="@(Link.Width)"
              stroke-dasharray="@dashArray" />
    }
}

@code {
    [Parameter]
    public RelationLinkModel Link { get; set; } = null!;
}
