<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Color="Color.Warning" />
            Unsaved Changes
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            You have unsaved changes in the current mapping. What would you like to do?
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Stay</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Discard">Discard &amp; Switch</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAndSwitch">Save &amp; Switch</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    public enum UnsavedChangesResult
    {
        Cancel,
        Discard,
        SaveAndSwitch
    }

    private void Cancel() => MudDialog.Close(DialogResult.Ok(UnsavedChangesResult.Cancel));
    private void Discard() => MudDialog.Close(DialogResult.Ok(UnsavedChangesResult.Discard));
    private void SaveAndSwitch() => MudDialog.Close(DialogResult.Ok(UnsavedChangesResult.SaveAndSwitch));
}
