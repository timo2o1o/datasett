@inherits LayoutComponentBase

@using DataSett.ViewModel

@inject WorkbenchMainViewmodel ViewModel

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        DataSett Workbench
        <MudSpacer />
        <MudTextField @bind-Value="ViewModel.ServerPath"
                      Label="Repository Path"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Folder"
                      AdornmentColor="Color.Inherit"
                      Immediate="false"
                      Style="max-width: 400px;"
                      Class="mr-2 mt-1" />
        <MudIconButton Icon="@Icons.Material.Filled.Upload"
                       Color="Color.Inherit"
                       OnClick="LoadDataFromPath"
                       title="Refresh" />
        <MudIconButton Icon="@Icons.Material.Filled.Save"
                       Color="Color.Inherit"
                       OnClick="@(() => ViewModel.SaveChangesAsync())"
                       title="Save Changes" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <MyNavMenu/>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task LoadDataFromPath()
    {
        await ViewModel.LoadDataFromPathAsync(ViewModel.ServerPath);
    }
}