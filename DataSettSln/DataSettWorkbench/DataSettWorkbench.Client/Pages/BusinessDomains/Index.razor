@page "/businessdomains"
@using DataSett.ViewModel
@using DataSett.ViewModel.Services
@inject BusinessDomainService DomainService
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>Business Domains</PageTitle>

<h1>Business Domains</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateDialog">
        <i class="bi bi-plus-circle"></i> Create New Domain
    </button>
</div>

@if (showCreateDialog)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Create New Business Domain</h5>
            <div class="mb-3">
                <label class="form-label">Domain Name</label>
                <input type="text" class="form-control" @bind="newDomainName" />
            </div>
            <button class="btn btn-success" @onclick="CreateDomain">Create</button>
            <button class="btn btn-secondary" @onclick="HideCreateDialog">Cancel</button>
        </div>
    </div>
}

@if (DomainService.Domains.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Domain Name</th>
                <th>Business Objects</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var domain in DomainService.Domains)
            {
                <tr>
                    <td>
                        @if (editingDomain == domain)
                        {
                            <input type="text" class="form-control" @bind="domain.Name" />
                        }
                        else
                        {
                            @domain.Name
                        }
                    </td>
                    <td>@domain.BusinessObjects.Count</td>
                    <td>
                        @if (editingDomain == domain)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => SaveEdit()">Save</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => CancelEdit()">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary" @onclick="() => EditDomain(domain)">Edit</button>
                            <button class="btn btn-sm btn-info" @onclick="() => ViewDetails(domain)">Details</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteDomain(domain)">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No business domains created yet. Click "Create New Domain" to get started.</p>
}

@code {
    private bool showCreateDialog = false;
    private string newDomainName = string.Empty;
    private BusinessDomainViewModel? editingDomain = null;
    private string? originalName = null;

    private void ShowCreateDialog()
    {
        showCreateDialog = true;
        newDomainName = string.Empty;
    }

    private void HideCreateDialog()
    {
        showCreateDialog = false;
        newDomainName = string.Empty;
    }

    private void CreateDomain()
    {
        if (!string.IsNullOrWhiteSpace(newDomainName))
        {
            DomainService.CreateDomain(newDomainName);
            HideCreateDialog();
        }
    }

    private void EditDomain(BusinessDomainViewModel domain)
    {
        editingDomain = domain;
        originalName = domain.Name;
    }

    private void SaveEdit()
    {
        editingDomain = null;
        originalName = null;
    }

    private void CancelEdit()
    {
        if (editingDomain != null && originalName != null)
        {
            editingDomain.Name = originalName;
        }
        editingDomain = null;
        originalName = null;
    }

    private void DeleteDomain(BusinessDomainViewModel domain)
    {
        DomainService.DeleteDomain(domain);
    }

    private void ViewDetails(BusinessDomainViewModel domain)
    {
        NavigationManager.NavigateTo($"/businessdomains/{domain.Name}");
    }
}
